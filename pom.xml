<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.ledger</groupId>
  <artifactId>ledger-service</artifactId>
  <version>0.1.0</version>
  <name>ledger-service</name>
  <description>Append-only double-entry ledger with DB-enforced accounting invariants</description>

  <properties>
    <java.version>17</java.version>
    <testcontainers.version>1.19.7</testcontainers.version>
    <jqwik.version>1.8.4</jqwik.version>
    <springdoc.version>2.5.0</springdoc.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Flyway: the schema (including the balance-enforcing trigger) is versioned
         and applied identically in dev, test and CI. Hibernate ddl-auto is off.

         Only flyway-core is declared. Spring Boot 3.2.x manages Flyway 9, where
         PostgreSQL support still ships inside core; the separate
         flyway-database-postgresql module is a Flyway 10 artifact and has no
         managed version in this BOM. Adding it without a version fails the
         build outright. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Prometheus-format metrics, including the reconciliation drift gauge.

         Compile scope, not runtime. The actuator's /actuator/prometheus endpoint
         is @ConditionalOnBean(PrometheusMeterRegistry), so with runtime scope the
         class is absent while the test context is built and the endpoint quietly
         404s in tests while working perfectly in the packaged app. The drift gauge
         is a correctness signal that CI gates on, so it needs to be assertable
         from a test, not only from a running container. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- OpenAPI spec generated from the controller annotations, not hand-written. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Structured JSON logs with a trace id per request. -->
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>7.4</version>
    </dependency>

    <!-- ==== test scope ==== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Property-based testing: generate random valid entry sequences and assert
         the ledger invariant holds after every one of them. -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <version>${jqwik.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- jqwik runs on the JUnit 5 platform alongside Jupiter. -->
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Properties.java</include>
          </includes>
          <!-- Concurrency tests spawn 100 threads; give the JVM room. -->
          <argLine>-Xmx1g</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
